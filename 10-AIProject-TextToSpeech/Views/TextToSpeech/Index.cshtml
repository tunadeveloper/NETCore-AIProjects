@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Text to Speech</title>
</head>
<body style="margin:0; padding:0; display:flex; justify-content:center; align-items:center; height:100vh; background: linear-gradient(to right, #8367B2, #B28FCF); font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <div style="background:white; padding:40px; border-radius:15px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); text-align:center; max-width:500px; width:100%;">
        <h1 style="margin-bottom:30px; color:#8367B2;">Text to Speech</h1>
        <form method="post">
            <input type="text" name="input" placeholder="Metni buraya girin..." required
                   style="width:100%; padding:15px; font-size:16px; border-radius:10px; border:1px solid #ccc; margin-bottom:20px; box-sizing:border-box;" />
            <button type="submit"
                    style="width:100%; padding:15px; font-size:16px; border-radius:10px; border:none; background-color:#8367B2; color:white; cursor:pointer;">
                Konuş
            </button>
        </form>
    </div>
</body>
</html>
