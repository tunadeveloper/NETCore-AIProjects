@{
    ViewData["Title"] = "Duygu Analizi";
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="text-center mb-4">
                <h1 class="fw-bold text-primary">AI Sentiment Analyzer</h1>
                <p class="text-muted">Metin girin, yapay zeka duygu durumunu analiz etsin.</p>
            </div>

            <form asp-action="Index" method="post" class="card shadow-sm p-4 border-0 rounded-4">
                <div class="mb-3">
                    <label for="inputText" class="form-label fw-semibold">Metin</label>
                    <textarea id="inputText" name="input" class="form-control" rows="4" placeholder="Bir şeyler yazın..."></textarea>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill">
                        Analiz Et
                    </button>
                </div>
            </form>

            @if (ViewBag.Sentiment != null)
            {
                <div class="mt-4">
                    <div class="card shadow border-0 rounded-4">
                        <div class="card-body text-center">
                            <h5 class="fw-bold text-secondary">Analiz Sonucu</h5>
                            <p class="fs-4 
                                @(ViewBag.Sentiment == "Positive" ? "text-success fw-bold" : 
                                  ViewBag.Sentiment == "Negative" ? "text-danger fw-bold" : 
                                  "text-warning fw-bold")">
                                @ViewBag.Sentiment
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
