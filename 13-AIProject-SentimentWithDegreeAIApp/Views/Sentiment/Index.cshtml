@{
    ViewData["Title"] = "Gelişmiş Duygu Analizi";
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="text-center mb-4">
                <h1 class="fw-bold text-primary">AI Emotion Analyzer</h1>
                <p class="text-muted">Metin girin, yapay zeka duygu oranlarını (0-100%) analiz etsin.</p>
            </div>

            <form asp-action="Index" method="post" class="card shadow-sm p-4 border-0 rounded-4">
                <div class="mb-3">
                    <label for="inputText" class="form-label fw-semibold">Metin</label>
                    <textarea id="inputText" name="input" class="form-control" rows="4" placeholder="Bir şeyler yazın..."></textarea>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill">
                        Analiz Et
                    </button>
                </div>
            </form>

            @if (ViewBag.Sentiment != null)
            {
                <div class="mt-5">
                    <div class="card shadow border-0 rounded-4">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3 text-secondary">Analiz Sonucu</h5>
                            <pre class="bg-light p-3 rounded-3 border mb-3">@ViewBag.Sentiment</pre>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
